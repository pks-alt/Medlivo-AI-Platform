FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /app

# Job Intelligence is an internal monorepo dependency. Keep one source of
# truth instead of copying its rules into the workspace service.
COPY services/job-intelligence /deps/job-intelligence
RUN pip install --no-cache-dir /deps/job-intelligence

COPY services/margin-engine /deps/margin-engine
RUN pip install --no-cache-dir /deps/margin-engine

COPY services/team-workspace/pyproject.toml ./
COPY services/team-workspace/workspace_api ./workspace_api
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home appuser

USER appuser
EXPOSE 8080
CMD ["sh", "-c", "uvicorn workspace_api.app:create_app --factory --host 0.0.0.0 --port ${PORT} --no-access-log"]
