# Build from repository root. Only the reviewed team routes enter this image.
# Existing Dockerfile, homepage, legacy jobs API and public preview are unchanged.
FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 TEAM_WORKSPACE_ENABLED=false
COPY apps/recruiter-web/package.json ./
RUN npm install --no-audit --no-fund
COPY apps/recruiter-web/tsconfig.json ./
COPY apps/recruiter-web/lib/team ./lib/team
COPY apps/recruiter-web/app/team ./app/team
COPY apps/recruiter-web/app/api/team ./app/api/team
COPY infrastructure/team-staging/root-route.ts ./app/route.ts
COPY infrastructure/team-staging/next.config.mjs ./next.config.mjs
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0 TEAM_WORKSPACE_ENABLED=false
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 8080
CMD ["node", "server.js"]
